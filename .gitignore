# ---------------------------------------------------------------------------
# Provenance guard — third-party source must never be committed here.
# License obligations travel with code. Local clones of other projects are
# kept OUTSIDE this working tree; these patterns are a second line of defence
# so an accidental copy cannot be staged.
# ---------------------------------------------------------------------------
reference/
vendor/
third_party/
external/
**/site-planner/
**/splat/

# ---------------------------------------------------------------------------
# PlatformIO / embedded build output.
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.vscode/extensions.json

# ---------------------------------------------------------------------------
# Credentials and keys. Nothing here should ever exist in this repository;
# these patterns are a backstop so a stray file cannot be staged by accident.
# ---------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.asc
*.gpg
credentials.json
credentials.yaml
service-account*.json
*-credentials.json
.netrc
.pypirc
secrets.*
*.secret

# ---------------------------------------------------------------------------
# Local-only working notes. Not published.
# ---------------------------------------------------------------------------
private/
*.local.md
notes.local/

# ---------------------------------------------------------------------------
# Field data — commit deliberately, never by accident.
# Raw captures can contain precise coordinates; review before publishing.
# ---------------------------------------------------------------------------
data/raw/
*.raw.csv

# ---------------------------------------------------------------------------
# Radio configuration dumps.
#
# `meshtastic --info` prints the node's PKI **private key** in its security
# block, alongside its fixed position. A private key on a public repository
# lets anyone impersonate that node on the mesh, and it cannot be un-published.
#
# Raw dumps therefore never leave the machine. Commit only redacted ones —
# `config/<node>.redacted.json`, with the security block removed — which is
# all the settings record was ever for.
# ---------------------------------------------------------------------------
config/
!config/*.redacted.json

# macOS Finder litter. Turns up in any directory the Finder has opened.
.DS_Store
